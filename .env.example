# --- Required -------------------------------------------------------------
# Client ID of your app on https://dashboard.yoto.dev
# (allowed callback URL: http://localhost:8080/auth/callback)
YOTO_CLIENT_ID=

# --- Optional -------------------------------------------------------------
# Smarter track icons chosen by Claude (https://console.anthropic.com)
ANTHROPIC_API_KEY=
# ANTHROPIC_MODEL=claude-haiku-5-5

# Nightly sync schedule (cron syntax) and timezone
SYNC_CRON=0 3 * * *
TZ=Europe/Paris

# URL you open Yotube with; must match the callback URL registered at Yoto
PUBLIC_URL=http://localhost:8080
PORT=8080

# Update yt-dlp at every container start (recommended)
YTDLP_AUTO_UPDATE=true
LOG_LEVEL=INFO
